<?xml version="1.0"?>
<PasswordChange>
<Variables>
<ALL>SMTPHost,CustomerName,FromEmail,expireindays,pwdchar,pastPwd,passComplex,FailureEmail,EnableSslEmail,smtpport,Delay,testuseraccountemail,TestingMode</ALL>
<Boolian>passComplex,EnableSslEmail,TestingMode</Boolian>
</Variables>
<Settings>
    <!--SMTP Host-->
        <SMTPHost>smtp.sendgrid.net</SMTPHost>
    <!--Customer Name-->
        <CustomerName>Generic</CustomerName>
    <!--Who is the e-mail from-->
        <FromEmail>PasswordNotification@example.com</FromEmail>
    <!--How many days prior to expiration do you want to start sending email?-->
        <expireindays>15</expireindays>
    <!--How many characters are required for the password-->
        <pwdchar>12</pwdchar>
    <!--How many previous passwords are remembered Must have a space in front of the number below-->
        <pastPwd> 24</pastPwd>
    <!--Password Complexity set to true or false?-->
        <passComplex>true</passComplex>
    <!--Who is going to get the notification that user does not have a valid email address?-->
        <FailureEmail>help@example.com</FailureEmail>
    <!--SSL Required for email (example is false)-->
        <EnableSslEmail>true</EnableSslEmail>
    <!--Which Port is required by client Exchange/O365-->
        <smtpport>587</smtpport>
    <!--Delay between emails (in Seconds) (noticed that there are too many emails per minute so they are being rejected, recommend 60 seconds)-->
        <Delay>15</Delay>
    <!--is this in testing mode?-->
        <TestingMode>true</TestingMode>
    <!-- Test User account who's account are we going to test with-->
        <testuseraccountemail></testuseraccountemail>

</Settings>
<Message>
<Complexity><p1><![CDATA[
	&emsp;5. It must contain at least one character from the following groups of characters:<br />
&emsp;&emsp;a. Uppercase letters (A-Z)<br />
&emsp;&emsp;b. Lowercase letters (a-z)<br />
&emsp;&emsp;c. Numbers (0-9)<br />
&emsp;&emsp;d. Symbols (!&#64;#&#36;%^&amp;*...)<br /> 
]]>
